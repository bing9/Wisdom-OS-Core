{
  "name": "wisdom-os-core",
  "version": "0.2.0",
  "private": false,
  "type": "module",
  "description": "Pi-native, local-first decision and learning kernel for durable multi-agent work.",
  "scripts": {
    "start": "pi -e .",
    "test": "node --test tests/*.test.mjs",
    "audit:portable": "node scripts/portability-audit.mjs",
    "release-check": "node scripts/release-check.mjs",
    "release-check:negative": "node scripts/release-check.mjs --negative",
    "check": "node scripts/release-check.mjs"
  },
  "files": [
    "extensions",
    "skills",
    "prompts",
    "src",
    "scripts/portability-audit.mjs",
    "scripts/release-check.mjs",
    "cli.mjs",
    "data/board.example.json",
    "docs"
  ],
  "pi": {
    "extensions": [
      "./extensions/wos-guards.ts",
      "./extensions/wos-butler.ts",
      "./extensions/wos-lane.ts",
      "./extensions/wos-dream.ts"
    ],
    "skills": [
      "./skills"
    ],
    "prompts": [
      "./prompts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "keywords": [
    "pi-package",
    "decision-os",
    "ai-agents",
    "context-engineering",
    "tui"
  ]
}
